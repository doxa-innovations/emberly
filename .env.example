# Demo defaults for running Emberly locally. These values are placeholders, not secrets.
# In production every secret below comes from Infisical (synced into a Kubernetes Secret);
# nothing real is ever committed to this repository.

APP_NAME=Emberly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=emberly
DB_USERNAME=emberly
DB_PASSWORD=emberly

SESSION_DRIVER=database
SESSION_LIFETIME=10080
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

OCTANE_SERVER=frankenphp

# Pixelforge: create one API key per environment at https://pixelforge.promptedit.dev
PIXELFORGE_API_KEY=
PIXELFORGE_WEBHOOK_SECRET=

# Simulated payment processor: any random string works locally.
PAYMENTS_WEBHOOK_SECRET=demo-payments-secret

# Google sign-in (optional locally; operators can always sign in with a password).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The operator account created by `php artisan db:seed`.
OPERATOR_EMAIL=operator@emberly.test
OPERATOR_PASSWORD=demo-operator-password

VITE_APP_NAME="${APP_NAME}"
